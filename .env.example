# Start native MySQL and use the credentials of your local StudySphere database user.
STUDYSPHERE_DB_NAME=studysphere
STUDYSPHERE_DB_USER=studysphere
STUDYSPHERE_DB_PASSWORD=
STUDYSPHERE_DB_PORT=3306

# Private resource storage. Filesystem is intended for local development.
STUDYSPHERE_STORAGE_PROVIDER=filesystem
STUDYSPHERE_STORAGE_DIRECTORY=./var/resources
# Selecting s3 requires a pre-provisioned private bucket and AWS SDK credentials.
STUDYSPHERE_STORAGE_BUCKET=
STUDYSPHERE_STORAGE_REGION=us-east-1
STUDYSPHERE_STORAGE_ENDPOINT=
STUDYSPHERE_STORAGE_PATH_STYLE=false

# Optional native SMTP settings. The default is a local development inbox on port 1025.
STUDYSPHERE_SMTP_HOST=127.0.0.1
STUDYSPHERE_SMTP_PORT=1025
STUDYSPHERE_SMTP_USER=
STUDYSPHERE_SMTP_PASSWORD=
STUDYSPHERE_SMTP_AUTH=false
STUDYSPHERE_SMTP_STARTTLS=false
STUDYSPHERE_MAIL_FROM=studysphere@localhost.test
STUDYSPHERE_FRONTEND_ORIGIN=http://localhost:5173
# Enable the default Secure cookie setting for all HTTPS environments.
STUDYSPHERE_AUTH_SECURE_COOKIES=true
# AI Study Mentor. Select none, openai or google-genai. Set only the selected provider's key.
STUDYSPHERE_AI_PROVIDER=none
STUDYSPHERE_EMBEDDING_PROVIDER=none
STUDYSPHERE_QDRANT_URL=http://127.0.0.1:6333
STUDYSPHERE_QDRANT_API_KEY=
STUDYSPHERE_QDRANT_COLLECTION=studysphere_documents
STUDYSPHERE_OPENAI_API_KEY=
STUDYSPHERE_OPENAI_MODEL=gpt-4o-mini
STUDYSPHERE_GEMINI_API_KEY=
STUDYSPHERE_GEMINI_MODEL=gemini-3.5-flash-lite
